# Secrets: generated per machine by `make env`. Keep a copy somewhere safe (see README).
.env
# Database dumps from `make backup`
backups/
# pdf-filler forms, data and mappings (keep .gitkeep)
pdf-filler/data/*
!pdf-filler/data/.gitkeep
# pdf-filler's hosted app: database, uploads, signatures
pdf-filler/app-data/
.DS_Store
