# `make env` copies this to .env and puts 32 random hex characters in place of the
# placeholder below (the app refuses tokens shorter than 24 characters).
PDF_FILLER_UI_TOKEN=change-me
# Optional: a CSV in ./data to pick columns from and preview, e.g. /data/data.csv
PDF_FILLER_CSV=
# Optional: other file names inside ./data
# PDF_FILLER_FORM_FILE=form.pdf
# PDF_FILLER_MAPPING_FILE=mapping.json
