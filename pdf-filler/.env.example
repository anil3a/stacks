# `make env` copies this to .env. pdf-filler (pdf-filler serve) needs no secrets to run.
# Optional: a seal key for the activity log (32+ characters, e.g. openssl rand -hex 32).
# Keep a copy somewhere safe: `pdf-filler audit verify` needs the same key later.
PDF_FILLER_AUDIT_KEY=
# Optional: open = anyone who can reach the page may create an account (default closed)
# PDF_FILLER_SIGNUP=closed
# PDF_FILLER_MAX_USERS=20
# Optional: Traefik's network if `docker network inspect proxy` shows another subnet
# PDF_FILLER_TRUSTED_PROXY=172.18.0.0/16
